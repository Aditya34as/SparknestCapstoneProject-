<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Quantity_Must_Be_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Quantity_Interested__c)), Quantity_Interested__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Quantity_Interested__c</errorDisplayField>
    <errorMessage>Quantity must be at least 1.</errorMessage>
</ValidationRule>
